; Engine configuration file.
config_version=5

[application]

config/name="Cat Game"
config/version="0.1.0"
run/main_scene="res://main.tscn"
run/main_scene.dedicated_server="res://server.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Updater="*res://scripts/updater.gd"
Net="*res://scripts/net/net.gd"
GameMenu="*res://scripts/game_menu.gd"
Save="*res://scripts/save_game.gd"
ExploreMap="*res://scripts/explore_map.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=144
common/max_physics_steps_per_frame=12
common/physics_ticks_per_second.web=72
common/physics_jitter_fix=0.0

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d.web=0

[xr]

openxr/enabled=false
openxr/default_action_map="res://openxr_action_map.tres"
openxr/reference_space=0
openxr/startup_alert=false
shaders/enabled=true
